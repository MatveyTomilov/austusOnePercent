<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Library</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ExileCorePath Condition="'$(ExileCorePath)' == ''">$(MSBuildProjectDirectory)\..\..\..</ExileCorePath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Reference Include="ExileCore"><HintPath>$(ExileCorePath)\ExileCore.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="GameOffsets"><HintPath>$(ExileCorePath)\GameOffsets.dll</HintPath><Private>False</Private></Reference>
    <Reference Include="Hexa.NET.ImGui"><HintPath>$(ExileCorePath)\Hexa.NET.ImGui.dll</HintPath><Private>False</Private></Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="SharpDX" Version="4.2.0" />
    <PackageReference Include="SharpDX.Mathematics" Version="4.2.0" />
  </ItemGroup>
</Project>
